<?xml version="1.0" encoding="utf-8"?>

<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/feedFragment">

    <action
        android:id="@+id/action_global_to_homeFragment"
        app:destination="@id/feedFragment"
        app:enterAnim="@anim/nav_default_enter_anim"
        app:exitAnim="@anim/nav_default_exit_anim"
        app:popEnterAnim="@anim/nav_default_pop_enter_anim"
        app:popExitAnim="@anim/nav_default_pop_exit_anim"
        app:launchSingleTop="true" />

    <action
        android:id="@+id/action_global_to_favouritesFragment"
        app:destination="@id/favouritesFragment"
        app:enterAnim="@anim/nav_default_enter_anim"
        app:exitAnim="@anim/nav_default_exit_anim"
        app:popEnterAnim="@anim/nav_default_pop_enter_anim"
        app:popExitAnim="@anim/nav_default_pop_exit_anim"
        app:launchSingleTop="true" />

    <action
        android:id="@+id/action_global_to_settingsFragment"
        app:destination="@id/settingsFragment"
        app:enterAnim="@anim/nav_default_enter_anim"
        app:exitAnim="@anim/nav_default_exit_anim"
        app:popEnterAnim="@anim/nav_default_pop_enter_anim"
        app:popExitAnim="@anim/nav_default_pop_exit_anim"
        app:launchSingleTop="true" />

    <action
        android:id="@+id/action_basicFragment_to_detailFragment"
        app:destination="@id/detailFragment"
        app:enterAnim="@anim/nav_default_enter_anim"
        app:exitAnim="@anim/nav_default_exit_anim"
        app:popEnterAnim="@anim/nav_default_pop_enter_anim"
        app:popExitAnim="@anim/nav_default_pop_exit_anim" />

    <!-- Labels refer to string resources declared in module-level build file -->
    <fragment
        android:id="@+id/feedFragment"
        android:name="com.tehgan.rssreader.ui.basic.feed.FeedFragment"
        android:label="@string/FL_FEED"
        tools:layout="@layout/fragment_feed" />

    <fragment
        android:id="@+id/favouritesFragment"
        android:name="com.tehgan.rssreader.ui.basic.favourites.FavouritesFragment"
        android:label="@string/FL_FAVOURITES"
        tools:layout="@layout/fragment_favourites" />

    <fragment
        android:id="@+id/detailFragment"
        android:name="com.tehgan.rssreader.ui.detail.DetailFragment"
        android:label="@string/FL_DETAIL"
        tools:layout="@layout/fragment_detail" >
        <argument
            android:name="rss"
            app:argType="com.tehgan.rssreader.data.Rss" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.tehgan.rssreader.ui.settings.SettingsFragment"
        android:label="@string/FL_SETTINGS"
        tools:layout="@layout/fragment_settings" />

</navigation>