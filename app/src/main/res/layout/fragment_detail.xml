<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding"
    tools:context=".ui.detail.DetailFragment">

    <!-- TODO: Rewrite to be prettier. Getting it working first. -->

    <!-- If height is wrap_content it takes the unscaled image dimensions,
            often causing the height to be either too short or too tall. -->
    <!-- 0dp (MATCH_CONSTRAINT) and constraintDimensionRatio work around this.
        I chose 16:9 as that's (roughly) the ratio of BBC's RSS thumbnails. -->
    <ImageView
        android:id="@+id/thumbnail"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="16:9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/thumb_placeholder"
        android:importantForAccessibility="no"
        tools:src="@tools:sample/backgrounds/scenic" />

    <TextView
        android:id="@+id/headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/thumbnail"
        android:layout_marginTop="8dp"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end"
        tools:text="@tools:sample/lorem/random" />

    <!-- Text is set programmatically, depending on whether the article is favourited or not -->
    <Button
        android:id="@+id/toggle_favourite"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_max="wrap"
        app:layout_constraintWidth_percent="0.4"
        app:layout_constraintTop_toBottomOf="@id/headline"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="@string/favourite" />

    <TextView
        android:id="@+id/date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/headline"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.6"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="@tools:sample/date/hhmmss" />

    <TextView
        android:id="@+id/link"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/date"
        app:layout_constraintBottom_toBottomOf="@id/toggle_favourite"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.6"
        app:layout_constraintHeight_max="wrap"
        android:textColor="@color/link"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="https://www.example.com" />

    <TextView
        android:id="@+id/description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/link"
        android:layout_marginTop="@dimen/padding"
        android:maxLines="10"
        android:ellipsize="end"
        tools:text="@tools:sample/lorem/random" />

</androidx.constraintlayout.widget.ConstraintLayout>