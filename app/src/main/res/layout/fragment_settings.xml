<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/padding"
    tools:context=".ui.settings.SettingsFragment">

    <TextView
        android:id="@+id/url_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="@string/url_info" />

    <!-- Hint is set programmatically to the module-level RSS_FALLBACK_URL -->
    <EditText
        android:id="@+id/url_edittext"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_set"
        app:layout_constraintTop_toBottomOf="@id/url_info"
        app:layout_constraintBottom_toBottomOf="@id/btn_clear"
        app:layout_constraintHorizontal_weight="1"
        android:inputType="textUri"
        android:maxLines="1"
        android:ellipsize="end"
        tools:ignore="Autofill,LabelFor" />

    <Button
        android:id="@+id/btn_set"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/url_edittext"
        app:layout_constraintEnd_toEndOf="@id/btn_clear"
        app:layout_constraintTop_toBottomOf="@id/url_info"
        app:layout_constraintHorizontal_weight="0.5"
        android:layout_marginLeft="@dimen/padding"
        android:text="@string/set" />

    <!-- Not active until the EditText contains user-entered text (either loaded from SharedPreferences or entered in-app) -->
    <Button
        android:id="@+id/btn_clear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/btn_set"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/url_info"
        app:layout_constraintHorizontal_weight="0.5"
        android:layout_marginLeft="@dimen/padding"
        android:enabled="false"
        android:text="@string/clear" />

</androidx.constraintlayout.widget.ConstraintLayout>